# Dinnerguest Environment Configuration

# ------------------------------------------------------------------------------
# Option A: Google Cloud Vertex AI (Recommended for Cloud Shell & GCP)
# Uses GCP Application Default Credentials / active Cloud Shell project.
# NO API key required. Ensure Vertex AI API (aiplatform.googleapis.com) is enabled.
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model selection (e.g. gemini-3.8-flash, gemini-2.5-flash, gemini-2.5-pro)
GEN_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Option B: Google AI Studio (Alternative)
# If you prefer using an AI Studio API key instead of Vertex AI:
# 1. Comment out GOOGLE_GENAI_USE_VERTEXAI above.
# 2. Uncomment GEMINI_API_KEY below and paste your key from https://aistudio.google.com/.
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
